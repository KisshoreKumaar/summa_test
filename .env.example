# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-side only — never expose it to the browser.
# Used by the seed script and by the auth callback to clean up ineligible
# OAuth signups.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Absolute URL of this deployment. Used to build auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signups are restricted to this email domain. Client-side validation reads
# this value; the database trigger enforces it using
# public.app_settings.allowed_email_domain, so update both when you change it.
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN=college-domain.edu
